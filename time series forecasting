# ============================================================
# TIME-SERIES FORECASTING WITH ARIMA AND PROPHET
# Data Science Research Capstone Project
# ============================================================

import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from statsmodels.tsa.arima.model import ARIMA
from sklearn.metrics import mean_absolute_error, mean_squared_error

# Prophet
from prophet import Prophet


# ============================================================
# 1. CREATE / LOAD DATASET
# ============================================================

np.random.seed(42)

# Monthly dates
dates = pd.date_range(
    start="2017-01-01",
    end="2024-12-01",
    freq="MS"
)

# Generate sample sales data
t = np.arange(len(dates))

sales = (
    500
    + 3.2 * t
    + 120 * np.sin(2 * np.pi * t / 12)
    + 45 * np.cos(2 * np.pi * t / 12)
    + np.random.normal(0, 35, len(t))
)

data = pd.DataFrame({
    "Date": dates,
    "Sales": np.round(sales, 0)
})

print("First 5 rows:")
print(data.head())

print("\nDataset Information:")
print(data.info())

print("\nMissing Values:")
print(data.isnull().sum())


# ============================================================
# 2. SAVE DATASET
# ============================================================

data.to_csv("monthly_sales_dataset.csv", index=False)

print("\nDataset saved as monthly_sales_dataset.csv")


# ============================================================
# 3. VISUALIZE TIME SERIES
# ============================================================

plt.figure(figsize=(12, 5))

plt.plot(
    data["Date"],
    data["Sales"],
    label="Monthly Sales"
)

plt.title("Monthly Sales Time Series")
plt.xlabel("Date")
plt.ylabel("Sales")
plt.legend()
plt.grid(True)

plt.tight_layout()
plt.savefig("sales_time_series.png", dpi=300)
plt.show()


# ============================================================
# 4. TRAIN-TEST SPLIT
# ============================================================

# Last 12 months are used for testing
train = data.iloc[:-12].copy()
test = data.iloc[-12:].copy()

print("\nTraining Data:")
print(train.tail())

print("\nTesting Data:")
print(test)


# ============================================================
# 5. ARIMA MODEL
# ============================================================

print("\n================ ARIMA MODEL ================")

arima_model = ARIMA(
    train["Sales"],
    order=(2, 1, 2)
)

arima_fit = arima_model.fit()

print(arima_fit.summary())


# ============================================================
# 6. ARIMA FORECAST
# ============================================================

arima_forecast = arima_fit.forecast(
    steps=len(test)
)

arima_forecast = np.array(arima_forecast)

print("\nARIMA Forecast:")
print(arima_forecast)


# ============================================================
# 7. ARIMA EVALUATION
# ============================================================

arima_mae = mean_absolute_error(
    test["Sales"],
    arima_forecast
)

arima_rmse = np.sqrt(
    mean_squared_error(
        test["Sales"],
        arima_forecast
    )
)

arima_mape = np.mean(
    np.abs(
        (test["Sales"] - arima_forecast)
        / test["Sales"]
    )
) * 100

print("\nARIMA Performance")
print("-------------------------")
print("MAE  :", round(arima_mae, 2))
print("RMSE :", round(arima_rmse, 2))
print("MAPE :", round(arima_mape, 2), "%")


# ============================================================
# 8. PROPHET MODEL
# ============================================================

print("\n================ PROPHET MODEL ================")

# Prophet requires columns ds and y
prophet_train = train.rename(
    columns={
        "Date": "ds",
        "Sales": "y"
    }
)

prophet_model = Prophet(
    yearly_seasonality=True,
    weekly_seasonality=False,
    daily_seasonality=False
)

prophet_model.fit(prophet_train)


# ============================================================
# 9. PROPHET FORECAST
# ============================================================

future = prophet_model.make_future_dataframe(
    periods=12,
    freq="MS"
)

prophet_prediction = prophet_model.predict(future)

# Get only test-period predictions
prophet_forecast = prophet_prediction[
    prophet_prediction["ds"].isin(test["Date"])
]["yhat"].values

print("\nProphet Forecast:")
print(prophet_forecast)


# ============================================================
# 10. PROPHET EVALUATION
# ============================================================

prophet_mae = mean_absolute_error(
    test["Sales"],
    prophet_forecast
)

prophet_rmse = np.sqrt(
    mean_squared_error(
        test["Sales"],
        prophet_forecast
    )
)

prophet_mape = np.mean(
    np.abs(
        (test["Sales"] - prophet_forecast)
        / test["Sales"]
    )
) * 100

print("\nProphet Performance")
print("-------------------------")
print("MAE  :", round(prophet_mae, 2))
print("RMSE :", round(prophet_rmse, 2))
print("MAPE :", round(prophet_mape, 2), "%")


# ============================================================
# 11. COMPARE MODELS
# ============================================================

results = pd.DataFrame({
    "Model": ["ARIMA", "Prophet"],
    "MAE": [
        arima_mae,
        prophet_mae
    ],
    "RMSE": [
        arima_rmse,
        prophet_rmse
    ],
    "MAPE": [
        arima_mape,
        prophet_mape
    ]
})

print("\n================ MODEL COMPARISON ================")
print(results.round(2))

results.to_csv(
    "model_comparison.csv",
    index=False
)


# ============================================================
# 12. ACTUAL VS ARIMA VS PROPHET
# ============================================================

plt.figure(figsize=(12, 6))

plt.plot(
    test["Date"],
    test["Sales"],
    marker="o",
    label="Actual"
)

plt.plot(
    test["Date"],
    arima_forecast,
    marker="o",
    label="ARIMA Forecast"
)

plt.plot(
    test["Date"],
    prophet_forecast,
    marker="o",
    label="Prophet Forecast"
)

plt.title("Actual vs ARIMA vs Prophet Forecast")
plt.xlabel("Date")
plt.ylabel("Sales")
plt.legend()
plt.grid(True)

plt.tight_layout()

plt.savefig(
    "forecast_comparison.png",
    dpi=300
)

plt.show()


# ============================================================
# 13. ARIMA FORECAST FOR FUTURE 12 MONTHS
# ============================================================

final_arima_model = ARIMA(
    data["Sales"],
    order=(2, 1, 2)
)

final_arima_fit = final_arima_model.fit()

future_arima = final_arima_fit.forecast(
    steps=12
)

future_dates = pd.date_range(
    start=data["Date"].iloc[-1] + pd.offsets.MonthBegin(1),
    periods=12,
    freq="MS"
)

future_arima_df = pd.DataFrame({
    "Date": future_dates,
    "ARIMA_Forecast": future_arima
})

print("\n================ FUTURE 12-MONTH ARIMA FORECAST ================")
print(future_arima_df)


# ============================================================
# 14. SAVE FUTURE FORECAST
# ============================================================

future_arima_df.to_csv(
    "future_arima_forecast.csv",
    index=False
)


# ============================================================
# 15. PROPHET FUTURE FORECAST
# ============================================================

final_prophet_data = data.rename(
    columns={
        "Date": "ds",
        "Sales": "y"
    }
)

final_prophet_model = Prophet(
    yearly_seasonality=True,
    weekly_seasonality=False,
    daily_seasonality=False
)

final_prophet_model.fit(final_prophet_data)

future_prophet_dates = final_prophet_model.make_future_dataframe(
    periods=12,
    freq="MS"
)

future_prophet = final_prophet_model.predict(
    future_prophet_dates
)

future_prophet_result = future_prophet[
    ["ds", "yhat", "yhat_lower", "yhat_upper"]
].tail(12)

print("\n================ FUTURE 12-MONTH PROPHET FORECAST ================")
print(future_prophet_result)


future_prophet_result.to_csv(
    "future_prophet_forecast.csv",
    index=False
)


# ============================================================
# 16. PROPHET FORECAST PLOT
# ============================================================

fig = final_prophet_model.plot(
    future_prophet
)

plt.title("Prophet Sales Forecast")
plt.xlabel("Date")
plt.ylabel("Sales")

plt.tight_layout()

plt.savefig(
    "prophet_forecast.png",
    dpi=300
)

plt.show()


# ============================================================
# 17. FINAL MESSAGE
# ============================================================

print("\n================================================")
print("PROJECT COMPLETED SUCCESSFULLY")
print("================================================")

print("\nGenerated Files:")
print("1. monthly_sales_dataset.csv")
print("2. sales_time_series.png")
print("3. model_comparison.csv")
print("4. forecast_comparison.png")
print("5. future_arima_forecast.csv")
print("6. future_prophet_forecast.csv")
print("7. prophet_forecast.png")

print("\nARIMA Results:")
print("MAE  :", round(arima_mae, 2))
print("RMSE :", round(arima_rmse, 2))
print("MAPE :", round(arima_mape, 2), "%")

print("\nProphet Results:")
print("MAE  :", round(prophet_mae, 2))
print("RMSE :", round(prophet_rmse, 2))
print("MAPE :", round(prophet_mape, 2), "%")
